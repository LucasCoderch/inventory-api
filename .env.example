APP_ENV=local
APP_NAME=Inventory API
APP_VERSION=0.1.0

POSTGRES_DB=inventory
POSTGRES_USER=inventory
POSTGRES_PASSWORD=inventory
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Auth (JWT) — cambia SECRET_KEY por un valor seguro en producción
SECRET_KEY=change-me-in-production-must-be-long-and-random
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
